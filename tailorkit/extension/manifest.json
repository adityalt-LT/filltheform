{
  "manifest_version": 3,
  "name": "Tailor & Apply",
  "version": "0.1.0",
  "description": "Capture a job page, see how well your resume matches, and get a tailored resume PDF.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Capture this job"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "http://localhost:3000/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}

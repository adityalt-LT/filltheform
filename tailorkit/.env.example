# Optional. Without a key the app runs in "basic mode":
# rule-based job extraction, matching and tailoring (no AI rewrites).
ANTHROPIC_API_KEY=
# Default model for all AI features. Cheaper options: claude-sonnet-5-5, claude-haiku-5-5
TAILORKIT_MODEL=claude-opus-5-5

PORT=3000
# Tailored resumes per calendar month on the free plan
FREE_MONTHLY_LIMIT=10
# Path to a Chromium/Chrome binary for PDF generation (auto-detected if empty)
CHROMIUM_PATH=
